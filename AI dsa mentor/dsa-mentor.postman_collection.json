		{
			"name": "Submissions",
			"item": [
				{
					"name": "Submit Code Solution",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"problemId\": 1,\n    \"sourceCode\": \"import java.util.HashMap;\\nclass Solution {\\n    public int[] twoSum(int[] nums, int target) {\\n        HashMap<Integer, Integer> map = new HashMap<>();\\n        for(int i=0; i<nums.length; i++) {\\n            int comp = target - nums[i];\\n            if(map.containsKey(comp)) {\\n                return new int[]{map.get(comp), i};\\n            }\\n            map.put(nums[i], i);\\n        }\\n        return new int[]{};\\n    }\\n}\",\n    \"language\": \"java\"\n}"
						},
